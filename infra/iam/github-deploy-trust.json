{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GithubActionsOidcBothSubjectForms",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::119331772192:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:Manoj816/emp-monitoring-system:ref:refs/heads/main",
            "repo:Manoj816/emp-monitoring-system:environment:production",
            "repo:Manoj816@221407696/emp-monitoring-system@1435794160:ref:refs/heads/main",
            "repo:Manoj816@221407696/emp-monitoring-system@1435794160:environment:production"
          ]
        }
      }
    }
  ]
}
