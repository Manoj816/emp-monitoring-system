{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken", "ecr:DescribeRepositories"],
      "Resource": "*"
    },
    {
      "Sid": "EcrProjectRepos",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages", "ecr:ListImages", "ecr:BatchDeleteImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:119331772192:repository/empverify-*"
    },
    {
      "Sid": "EcsRead",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition", "ecs:ListTaskDefinitions", "ecs:RegisterTaskDefinition",
        "ecs:ListClusters", "ecs:DescribeClusters", "ecs:ListServices"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcsProjectCluster",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService", "ecs:ListTasks", "ecs:DescribeTasks", "ecs:StopTask"],
      "Resource": "*",
      "Condition": { "ArnLike": { "ecs:cluster": "arn:aws:ecs:us-east-1:119331772192:cluster/empverify-*" } }
    },
    {
      "Sid": "PassTaskRolesToEcsOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::119331772192:role/empverify-ecs-execution",
        "arn:aws:iam::119331772192:role/empverify-ecs-task"
      ],
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    },
    {
      "Sid": "LogsList",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "LogsReadProject",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:FilterLogEvents", "logs:GetLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:119331772192:log-group:/ecs/empverify-*",
        "arn:aws:logs:us-east-1:119331772192:log-group:/ecs/empverify-*:*"
      ]
    },
    {
      "Sid": "AdminPortalUsers",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser", "cognito-idp:AdminSetUserPassword", "cognito-idp:AdminGetUser",
        "cognito-idp:AdminDeleteUser", "cognito-idp:ListUsers", "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:119331772192:userpool/us-east-1_BgN1UpvU4"
    },
    {
      "Sid": "Diagnostics",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity", "cloudtrail:LookupEvents"],
      "Resource": "*"
    },
    {
      "Sid": "SelfRead",
      "Effect": "Allow",
      "Action": ["iam:GetUser", "iam:ListAttachedUserPolicies", "iam:ListMFADevices"],
      "Resource": "arn:aws:iam::119331772192:user/empverify-deployer"
    },
    {
      "Sid": "InfraOnlyWithMfa",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::119331772192:role/empverify-infra-admin"
    }
  ]
}
