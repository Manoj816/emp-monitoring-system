# Copy to .env.local. Face Liveness needs browser-side AWS credentials; the pool's
# unauthenticated role is scoped to rekognition:StartFaceLivenessSession only.
# Values come from `terraform output` in infra/terraform/stack.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
