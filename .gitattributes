# cmd.exe reads a batch file line by line as it runs it; keep CRLF so the
# parenthesised blocks in the installer launchers behave the same wherever the
# bundle is unzipped.
*.cmd text eol=crlf
*.bat text eol=crlf

# Spreadsheets on Windows open a CSV most predictably with CRLF, and the import
# template is meant to be downloaded and opened in Excel as-is.
*.csv text eol=crlf
