<Window x:Class="EmpVerify.Agent.Windows.CheckPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identity check"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
    <StackPanel Margin="20">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Identity verification check"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="A scheduled identity check is due. Your webcam will take a single photo for verification. The camera indicator will be visible while it is in use."/>
        <TextBlock x:Name="CountdownText" Margin="0,10,0,0" Foreground="Gray"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="NotNowButton" Content="Not now" Width="90" Margin="0,0,8,0" Click="NotNow_Click"/>
            <Button x:Name="StartButton" Content="Start verification" Width="130" Click="Start_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
