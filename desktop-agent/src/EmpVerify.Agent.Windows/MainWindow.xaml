<Window x:Class="EmpVerify.Agent.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PresenSure Workforce" Width="0" Height="0"
        ShowInTaskbar="False" WindowStyle="None" Visibility="Hidden"
        Icon="Assets/EmpVerify.ico">
    <!-- The agent is a background app: this window is never shown. Everything is
         scheduled by the administrator from the portal, so there is nothing here
         for the employee to click and no activity list for them to read. The
         class survives only as the WPF host for the tray icon and the scheduling
         timer; the only windows an employee ever sees are the check windows,
         which a scan cannot happen without. -->
    <Grid/>
</Window>
