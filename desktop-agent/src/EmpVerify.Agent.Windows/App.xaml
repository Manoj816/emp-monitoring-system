<Application x:Class="EmpVerify.Agent.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EmpVerify.Agent.Windows"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: App.OnStartup wires the tray and decides whether to show
         the window or start minimized in the background. ShutdownMode is explicit
         so closing the window hides to tray instead of exiting. -->
    <Application.Resources />
</Application>
